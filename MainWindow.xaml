<Window x:Class="DuplicateFileDetectorMerge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DuplicateFileDetectorMerge"
        mc:Ignorable="d"
        Title="Duplicate File Detector / Merge" Height="600" Width="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Folder selection -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Compare To Folder:" VerticalAlignment="Center"/>
            <TextBox x:Name="CompareToFolderTextBox" Grid.Row="0" Grid.Column="1" Margin="5" IsReadOnly="True" VerticalContentAlignment="Center"/>
            <Button x:Name="SelectCompareToFolderButton" Grid.Row="0" Grid.Column="2" Content="Browse..." Width="90" Margin="5" Click="SelectCompareToFolderButton_Click"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Compare From Folder:" VerticalAlignment="Center"/>
            <TextBox x:Name="CompareFromFolderTextBox" Grid.Row="1" Grid.Column="1" Margin="5" IsReadOnly="True" VerticalContentAlignment="Center"/>
            <Button x:Name="SelectCompareFromFolderButton" Grid.Row="1" Grid.Column="2" Content="Browse..." Width="90" Margin="5" Click="SelectCompareFromFolderButton_Click"/>
        </Grid>

        <!-- Action buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BuildListsButton" Content="Build Lists" Width="140" Margin="0,0,10,0" IsEnabled="False" Click="BuildListsButton_Click"/>
            <Button x:Name="ExecuteComparisonButton" Content="Execute Comparison" Width="160" IsEnabled="False" Click="ExecuteComparisonButton_Click"/>
        </StackPanel>

        <!-- Status counts -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="CompareToCountText" Text="Compare To List: 0" Margin="0,0,20,0"/>
            <TextBlock x:Name="CompareFromCountText" Text="Compare From List: 0" Margin="0,0,20,0"/>
            <TextBlock x:Name="MatchedCountText" Text="Matched: 0" Margin="0,0,20,0"/>
            <TextBlock x:Name="MigrateCountText" Text="To Migrate: 0"/>
        </StackPanel>

        <!-- Current perceptual-hash comparison details -->
        <StackPanel x:Name="CurrentComparisonPanel" Grid.Row="3" Orientation="Vertical" Margin="0,0,0,10" Visibility="Collapsed">
            <TextBlock x:Name="CompareFromCurrentText" Text=""/>
            <TextBlock x:Name="CompareToCurrentText" Text=""/>
        </StackPanel>

        <!-- Log / results output -->
        <TextBox x:Name="LogTextBox" Grid.Row="4" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas"/>
    </Grid>
</Window>
